PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGO_URI=mongodb://127.0.0.1:27017/civicfix
JWT_SECRET=replace-with-a-long-random-secret
# Optional: new accounts using this email are created as administrators.
ADMIN_EMAIL=
# Choose gemini or openai; the chosen provider key is server-side only.
AI_PROVIDER=gemini
# Keep the selected provider key private in server/.env; never put it in client/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Citizen follow-up timing for unresolved reports.
FOLLOW_UP_DAYS=15
ESCALATION_DAYS=30
